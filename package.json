{
  "name": "capgoTestApp",
  "private": true,
  "version": "0.0.1-beta1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint .",
    "swap-config": "bun run ./swapCapacitorConfig.ts",
    "swap-package-json": "bun run ./swapPackageJson.ts && bun i",
    "proxy": "mitmweb --mode reverse:http://0.0.0.0:54321",
    "proxy-s3": "mitmweb --listen-port 9400 --web-port 9401 --mode reverse:http://0.0.0.0:9000",
    "reverse-ports-android": "adb reverse tcp:8080 tcp:8080 && adb reverse tcp:9000 tcp:9000",
    "macos-replace-count-str": "LC_CTYPE=C find ./dist -type f -exec sed -i '' -E 's/\"Count v[0-9]+: \"/\"Count v5: \"/g' {} \\;"
  },
  "TEST": "@capgo/camera-preview @capgo/camera-preview @capgo/camera-preview",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/camera-preview": "^8.0.3",
    "@capgo/capacitor-data-storage-sqlite": "^8.0.1",
    "@capgo/capacitor-screen-recorder": "^8.2.2",
    "@capgo/capacitor-shake": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.1.0",
    "@capgo/capacitor-updater": "^8.0.0",
    "@capgo/capacitor-uploader": "^8.0.1",
    "@capgo/inappbrowser": "^8.0.1",
    "@capgo/native-audio": "^8.1.0",
    "@capgo/native-purchases": "^8.0.1",
    "@ionic/vue": "^8.7.13",
    "@ionic/vue-router": "^8.7.13",
    "@trapezedev/configure": "^7.1.3",
    "@types/bun": "^1.3.4",
    "csv-writer": "^1.6.0",
    "global-agent": "^3.0.0",
    "ionicons": "^7.4.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.22",
    "cypress": "^13.17.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.2.12"
  },
  "description": "An Ionic project"
}
